---
import fs from 'node:fs';
import path from 'node:path';
import type { Locale, Translations } from '../i18n/types';
import { siteConfig } from '../data/config';

interface Props {
  t: Translations;
  locale: Locale;
}

const { t, locale } = Astro.props;
const currentCv = siteConfig.cv[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Check if CV file exists on disk
const cvFileExists = fs.existsSync(path.join(process.cwd(), 'public', currentCv.path));

// Check if Recommendation Letter file exists on disk
const currentRec = siteConfig.recommendationLetter[locale];
const recLetterExists = fs.existsSync(path.join(process.cwd(), 'public', currentRec.path));

// Check if optional profile photo exists on disk
const profilePhotoPath = '/images/profile.webp';
const hasProfilePhoto = fs.existsSync(path.join(process.cwd(), 'public', profilePhotoPath));
---

<section
  id="hero"
  class="relative pt-6 pb-8 sm:pt-8 sm:pb-10 md:pt-10 md:pb-12 border-b border-slate-200/70 dark:border-slate-800/70"
  aria-labelledby="hero-name"
>
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col-reverse md:flex-row md:items-start md:justify-between gap-6 md:gap-10">
      <!-- Main Content -->
      <div class="max-w-2xl flex-1">
        <!-- Subtle Open to Work Status Line -->
        <div class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-slate-50 px-2.5 py-0.5 text-xs font-mono text-slate-600 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-400 mb-3.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span>{t.hero.openToWorkStatus}</span>
        </div>

        <!-- Name Heading (Compact Scale) -->
        <h1
          id="hero-name"
          class="text-3xl sm:text-4xl md:text-[38px] font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight"
        >
          {t.hero.name}
        </h1>

        <!-- Title & Subtitle -->
        <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="text-lg sm:text-xl font-bold text-brand-600 dark:text-brand-400">
            {t.hero.title}
          </span>
          <span class="text-sm sm:text-base font-mono text-slate-500 dark:text-slate-400">
            — {t.hero.subtitle}
          </span>
        </div>

        <!-- ONE short 2–3 line summary -->
        <p class="mt-3.5 text-[15px] sm:text-base leading-relaxed text-slate-600 dark:text-slate-300 font-normal">
          {t.hero.descriptionParagraphs[0]}
        </p>

        <!-- CTA Buttons with Clear Hierarchy -->
        <div class="mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3">
          <!-- Primary CTA: Download CV (if file exists) -->
          {
            cvFileExists && (
              <a
                href={`${base}${currentCv.path}`}
                download
                class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-xs transition-all hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 dark:bg-brand-500 dark:text-slate-950 dark:hover:bg-brand-400 dark:focus-visible:outline-brand-400"
              >
                <svg
                  class="mr-2 h-4 w-4 text-slate-300 dark:text-slate-950"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>{t.hero.cta.downloadCv}</span>
              </a>
            )
          }

          <!-- Recommendation Letter CTA -->
          {
            recLetterExists && (
              <a
                href={`${base}${currentRec.path}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-medium text-slate-700 shadow-2xs transition-all hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
              >
                <svg
                  class="mr-1.5 h-4 w-4 text-brand-600 dark:text-brand-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>{t.hero.cta.recommendationLetter}</span>
              </a>
            )
          }

          <!-- Secondary CTA: View Experience -->
          <a
            href="#experience"
            class={`inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-2xs transition-all hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 ${
              !cvFileExists ? 'bg-slate-900 text-white dark:bg-brand-500 dark:text-slate-950 font-semibold' : ''
            }`}
          >
            <span>{t.hero.cta.viewExperience}</span>
            <svg
              class="ml-1.5 h-3.5 w-3.5 text-slate-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <!-- Tertiary CTA: Telegram -->
          <a
            href={siteConfig.telegramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 transition-all hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-400 dark:hover:text-slate-200"
            aria-label="Telegram"
          >
            <svg class="mr-1.5 h-3.5 w-3.5 fill-current text-[#229ED9]" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>{t.hero.cta.telegram}</span>
          </a>

          <!-- Tertiary CTA: LinkedIn -->
          {
            siteConfig.linkedInUrl && (
              <a
                href={siteConfig.linkedInUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-xs sm:text-sm font-medium text-slate-600 transition-all hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-400 dark:hover:text-slate-200"
                aria-label="LinkedIn profile"
              >
                <svg class="mr-1.5 h-3.5 w-3.5 fill-current text-[#0A66C2]" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                </svg>
                <span>{t.hero.cta.linkedIn}</span>
              </a>
            )
          }
        </div>
      </div>

      <!-- Optional Profile Photo (Right column on desktop, neat top on mobile) -->
      {
        hasProfilePhoto && (
          <div class="shrink-0 self-start">
            <div class="relative h-28 w-28 sm:h-32 sm:w-32 md:h-36 md:w-36 rounded-2xl border border-slate-200/80 p-1 dark:border-slate-800 shadow-2xs overflow-hidden bg-slate-100 dark:bg-slate-900">
              <img
                src={`${base}${profilePhotoPath}`}
                alt={t.hero.name}
                width="144"
                height="144"
                class="h-full w-full rounded-xl object-cover"
                loading="eager"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
